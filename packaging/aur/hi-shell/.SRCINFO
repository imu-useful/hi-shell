pkgbase = hi-shell
	pkgdesc = A Quickshell desktop shell for Hyprland: bar, dock, launcher, sidebars, notifications, Material You colors
	pkgver = 2.2.0
	pkgrel = 1
	url = https://github.com/imu-useful/hi-shell
	install = hi-shell.install
	arch = any
	license = GPL-2.0-only
	depends = bash
	depends = python
	depends = python-fonttools
	depends = hyprland
	depends = quickshell
	depends = qt6-multimedia-ffmpeg
	depends = ttf-material-symbols-variable
	depends = matugen
	depends = imagemagick
	depends = curl
	depends = pipewire
	depends = wireplumber
	depends = networkmanager
	depends = bluez
	depends = upower
	depends = libnotify
	depends = wl-clipboard
	depends = cliphist
	optdepends = grim: screenshots
	optdepends = slurp: screenshots of a region
	optdepends = wf-recorder: screen recording
	optdepends = ffmpeg: screen recording, video wallpapers
	optdepends = tesseract: text from the screen (OCR)
	optdepends = tesseract-data-eng: OCR in English
	optdepends = tesseract-data-rus: OCR in Russian
	optdepends = translate-shell: the translator
	optdepends = libqalculate: the calculator in the launcher
	optdepends = hyprlock: the lock screen
	optdepends = hypridle: idle lock and sleep
	optdepends = hyprsunset: night light
	optdepends = hyprpicker: the color picker
	optdepends = brightnessctl: screen brightness
	optdepends = ddcutil: brightness of external monitors
	optdepends = cava: the music visualizer
	optdepends = wtype: typing emoji and clipboard entries
	optdepends = pacman-contrib: the package updates in the bar (checkupdates)
	optdepends = paru: AUR updates in the bar
	optdepends = yay: AUR updates in the bar
	optdepends = fd: file search in the launcher
	optdepends = qrencode: hi qr
	optdepends = starship: the prompt of the fish config
	optdepends = claude-code: the AI chat and palette
