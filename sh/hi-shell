#!/bin/sh
# hi-shell command line (also installed as `hi`).
#
#   Shell        hi start | stop | restart | status | log [-f] | doctor | version
#   Install      hi update [--check] | channel [git|release] | install [options] | uninstall [--purge]
#                hi completions bash|zsh|fish   (install.sh sets them up)
#   Panels       hi settings [page|search <word>] | launcher | apps | overview | calendar | weather | processes
#                hi sidebar [left|right] | bar [show|hide|toggle|edit|done|list|add|rm|monitor|instance] | lock | wait | present
#                hi ask <prompt>    hi theme [dark|light|toggle|<scheme>|seed <#rrggbb>]    hi wallpaper [random|<file>]
#   Session      hi session [suspend|hibernate|reboot|poweroff|logout|lock]   hi boot [list|<entry>]
#   Screen       hi shot [region|full|ocr|translate|record|stop]   hi brightness [up|down|<percent>]
#                hi display [toggle|next|internal|mirror|left|right|external]   hi powersave [on|off|toggle|status]
#   Daily        hi notif [list|clear|dnd|dismiss <id>]   hi todo [list|add <text>|done <n>]
#                hi focus [status|start|stop|abort|task <text>|profile <id>]   hi screentime [today|limits|limit <app> <min>]
#                hi sounds <miui|samsung|iphone|windows|win7|winxp|android>
#   Config       hi config get <option|section>      hi config set <option> <value>
#                hi config reset [option|section]    hi config edit | path | reload | search <word>
#   Screens      hi dock screens <all|name...>   hi desktop screens|own ...   hi wallpaper screen <name> <file|none>
#   Looks        hi look [list|<name>|save <name>|rm <name>]
#   Rules        hi rules [list|templates|add <template>|edit <id>|on|off <id>|rm <id>|facts|check]
#   Widgets      hi widgets [list|new <name>|edit <name>|reload|path]   hi script <name> '<command>' [seconds] [icon] [template]
#   Presets      hi preset list|save [--profile]|load <name> [--only bar,dock] [--trust]|diff|undo|dump <dir>|restore <dir>
#   Media        hi play | pause | next | prev
#   Other        hi qr [text] | keybinds [word] | ipc [<target> <function> [args]] | help
#
# install.sh links this file to ~/.local/bin/hi-shell and ~/.local/bin/hi.
set -u

have() { command -v "$1" >/dev/null 2>&1; }

# The comment block at the top, up to the install.sh line.
usage() { sed -n '2,/^# install\.sh links/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; }

doctor() {
    bad=0
    row() { # status, name, note
        printf '  %s %-14s %s\n' "$1" "$2" "$3"
    }
    echo "Shell"
    if qs -c hi-shell list 2>/dev/null | grep -q 'Process ID'; then
        row "✔" "running" ""
        errors=$(qs -c hi-shell log 2>/dev/null | grep -c ' ERROR')
        if [ "$errors" -gt 0 ]; then row "✘" "log" "$errors errors: qs -c hi-shell log | grep ERROR"; bad=1; else row "✔" "log" "no errors"; fi
    else
        row "✘" "running" "not running: start it with run.sh or log in again"; bad=1
    fi
    echo "Install"
    link="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/hi-shell"
    if [ "$(readlink -f "$link" 2>/dev/null)" = "$repo" ]; then row "✔" "link" "$link -> $repo"
    else row "✘" "link" "$link doesn't point at $repo: run hi install"; bad=1; fi
    if [ -f "$repo/.package" ]; then
        row "✔" "package" "installed with pacman, hi is in /usr/bin"
    else
        case ":$PATH:" in
            *":$HOME/.local/bin:"*) row "✔" "PATH" "~/.local/bin is on it" ;;
            *) row "–" "PATH" "~/.local/bin isn't on PATH: hi works only by its full path" ;;
        esac
    fi
    hypr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
    if grep -rqF --include='*.lua' ".config/hypr/hi-shell/init.lua" "$hypr_dir" 2>/dev/null; then row "✔" "hyprland" "loads hypr/hi-shell/init.lua"
    else row "✘" "hyprland" "the Hyprland config doesn't load hi-shell: hi install"; bad=1; fi
    for f in "$hypr_dir"/hi-shell/*.lua.new; do
        [ -e "$f" ] && row "–" "$(basename "$f")" "an update waits next to your edited file: merge it by hand"
    done
    row "✔" "version" "$(version_line) ($(channel_get))"
    echo "Required"
    for p in qs hyprctl python3; do
        if have "$p"; then row "✔" "$p" ""; else row "✘" "$p" "missing"; bad=1; fi
    done
    echo "Optional (the feature that needs it)"
    for pair in "matugen:colors from the wallpaper" "claude:AI chat with Claude" "cliphist:clipboard history" \
        "wl-copy:clipboard" "qalc:calculator" "grim:screenshots" "slurp:screenshots" "tesseract:OCR" \
        "wf-recorder:screen recording" "cava:visualizer" "hyprlock:lock screen" "hypridle:idle lock and sleep" \
        "hyprsunset:night light" "hyprpicker:color picker" "brightnessctl:brightness" "magick:wallpaper thumbnails" \
        "fd:file search in the launcher (~)" "qrencode:hi-shell qr" "bootctl:Reboot to…" "trans:translator"; do
        p=${pair%%:*}
        if have "$p"; then row "✔" "$p" ""; else row "–" "$p" "missing: ${pair#*:}"; fi
    done
    [ "$bad" -eq 0 ] && echo "All good." || echo "Something needs attention (✘ above)."
    return "$bad"
}

qr() {
    have qrencode || { echo "qrencode isn't installed (pacman -S qrencode)" >&2; return 1; }
    if [ $# -gt 0 ]; then
        text="$*"
    elif have wl-paste; then
        text=$(wl-paste --no-newline 2>/dev/null)
    else
        text=""
    fi
    [ -n "$text" ] || { echo "Nothing to encode: give some text or copy it first." >&2; return 1; }
    qrencode -t ansiutf8 -m 1 -- "$text"
}

keybinds() {
    have hyprctl || { echo "hyprctl not found" >&2; return 1; }
    have python3 || { echo "python3 not found" >&2; return 1; }
    hyprctl binds -j | python3 -I -c '
import json, sys
word = " ".join(sys.argv[1:]).lower()
mods = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]
rows = []
for b in json.load(sys.stdin):
    if b.get("submap"):
        continue
    keys = " + ".join([n for bit, n in mods if b.get("modmask", 0) & bit] + [b.get("key") or "code:%s" % b.get("keycode")])
    desc = b.get("description") or b.get("dispatcher", "")
    if word in (keys + " " + desc).lower():
        rows.append((keys, desc))
width = max([len(k) for k, _ in rows] or [0])
for keys, desc in sorted(rows):
    print("%-*s  %s" % (width, keys, desc))
' "$@"
}

here=$(dirname "$(readlink -f "$0")")
repo=$(dirname "$here")
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/config.json"

# A value that starts with [ is mangled by qs ipc (["a"] arrives as a); the commands below put a space before JSON.
ipc() { qs -c hi-shell ipc call "$@"; }

running() { qs -c hi-shell list 2>/dev/null | grep -q 'Process ID'; }

need_running() {
    running || { echo "hi-shell isn't running: hi start" >&2; exit 1; }
}

start() {
    if running; then echo "Already running."; return 0; fi
    # run.sh makes the icon font and picks the Vulkan renderer; -d detaches.
    if [ -x "$repo/run.sh" ]; then "$repo/run.sh" -d; else qs -c hi-shell -d; fi
    echo "Started."
}

stop() { qs -c hi-shell kill >/dev/null 2>&1 && echo "Stopped." || echo "Not running."; }

status() {
    if running; then
        qs -c hi-shell list 2>/dev/null | grep -E 'Process ID|Launch time|Config path' | sed 's/^ *//'
        echo "Errors in the log: $(qs -c hi-shell log 2>/dev/null | grep -c ' ERROR')"
    else
        echo "Not running."
        return 1
    fi
}

log() {
    if [ "${1:-}" = "-f" ]; then exec qs -c hi-shell log -f; fi
    qs -c hi-shell log 2>&1 | tail -n "${1:-60}"
}

config() {
    sub=${1:-help}
    [ $# -gt 0 ] && shift
    case "$sub" in
        get) need_running; ipc config get "${1:-}" ;;
        set)
            [ $# -ge 2 ] || { echo "Usage: hi config set <option> <value>   (value is JSON: 40, true, \"top\"; a bare word is a string)" >&2; exit 1; }
            need_running; opt=$1; shift; ipc config set "$opt" " $*" ;;
        reset) need_running; ipc config reset "${1:-}" ;;
        path) echo "$cfg" ;;
        # hi config search <word...>: options by name or description, with default and where to change them
        search) [ $# -gt 0 ] || { echo "Usage: hi config search <word...>" >&2; exit 1; }; python3 "$repo/tools/config_meta.py" search "$@" ;;
        edit) "${VISUAL:-${EDITOR:-nano}}" "$cfg" ;;
        reload) need_running; touch "$cfg"; echo "Touched $cfg: the shell reloads it." ;;
        *) echo "Usage: hi config get|set|reset|search|edit|path|reload" >&2; exit 1 ;;
    esac
}

sidebar() {
    need_running
    case "${1:-right}" in
        left | l) ipc sidebarLeft toggle ;;
        *) ipc sidebarRight toggle ;;
    esac
}

barcmd() {
    need_running
    sub=${1:-toggle}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list) ipc config get bar.extra; echo "per screen:"; ipc config get bar.monitors; echo "copies:"; ipc config get bar.instances ;;
        # hi bar add <id> [position] [widgets...]: an extra bar, its widgets in the center
        add)
            [ -n "${1:-}" ] || { echo "Usage: hi bar add <id> [top|bottom|left|right] [widget...]" >&2; exit 1; }
            json=$(python3 -I -c '
import json, sys
id_, pos, widgets = sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "bottom", sys.argv[3:]
print(json.dumps({"id": id_, "position": pos, "center": widgets}))' "$@") || exit 1
            ipc config listput bar.extra "$json" >/dev/null && echo "Added the bar $1" ;;
        rm | remove) [ -n "${1:-}" ] || { echo "Usage: hi bar rm <id>" >&2; exit 1; }; ipc config listdel bar.extra "$1" >/dev/null && echo "Removed the bar $1" ;;
        # hi bar monitor <screen> <key> <json>: override one setting of the main bar on a screen (null = back to the default)
        monitor)
            [ $# -ge 3 ] || { echo "Usage: hi bar monitor <screen> <enabled|position|style|height|margin|left|center|right> <json|null>   (screens: hyprctl monitors)" >&2; exit 1; }
            ipc config map bar.monitors "$1.$2" " $3" >/dev/null && echo "Done" ;;
        # hi bar instance <type#name> <json>: a copy of a widget with options of its own, e.g. 'zoneClock#tokyo' '{"zone":"Asia/Tokyo"}'
        instance)
            case "${1:-}" in *.*) echo "The name can't have a dot" >&2; exit 1 ;; esac
            [ $# -ge 2 ] || { echo "Usage: hi bar instance <type#name> <json|null>   e.g. 'resources#disks' '{\"shown\":[\"disk\"]}'" >&2; exit 1; }
            ipc config map bar.instances "$1" " $2" >/dev/null && echo "Done" ;;
        edit) ipc bar edit ;;
        done) ipc bar done ;;
        *) ipc bar "$sub" ;;
    esac
}

theme() {
    need_running
    case "${1:-toggle}" in
        dark | light) ipc theme setMode "$1" ;;
        seed) [ -n "${2:-}" ] || { echo "Usage: hi theme seed <#rrggbb|wallpaper>" >&2; exit 1; }
            case "$2" in wallpaper | none) c='""' ;; *#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) c="\"$2\"" ;; *) echo "A color looks like #rrggbb" >&2; exit 1 ;; esac
            ipc config set appearance.seedColor "$c" ;;
        toggle) ipc theme toggleMode ;;
        *) ipc theme setScheme "$1" ;;
    esac
}

wallpaper() {
    need_running
    case "${1:-select}" in
        random) ipc wallpaper random ;;
        select) ipc wallpaper toggleSelector ;;
        get) ipc wallpaper get ;;
        # hi wallpaper screen <name> <file|none>: a picture for one screen only
        screen)
            [ $# -ge 3 ] || { echo "Usage: hi wallpaper screen <screen> <file|none>   (screens: hyprctl monitors)" >&2; exit 1; }
            if [ "$3" = none ]; then val=null; else val=$(python3 -I -c 'import json,os,sys; print(json.dumps(os.path.realpath(sys.argv[1])))' "$3"); fi
            ipc config map wallpapers.perScreen "$2" " $val" >/dev/null && echo "Done" ;;
        *) ipc wallpaper set "$(readlink -f "$1")" ;;
    esac
}

# hi preset: presets (config, wallpaper, colors) and profiles (also rules, scripts, widgets, keybinds); see docs/PROFILES.md
preset() {
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    state="${XDG_STATE_HOME:-$HOME/.local/state}/hi-shell"
    presets_dir="${XDG_DATA_HOME:-$HOME/.local/share}/hi-shell/presets"
    py="$repo/services/presets.py"
    wd="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/widgets"
    bf="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/binds.lua"
    # A name without a slash is a preset in the presets folder.
    resolve() {
        case "$1" in
            */* | *.tar.gz) readlink -f "$1" ;;
            *) echo "$presets_dir/$1.tar.gz" ;;
        esac
    }
    # --only <parts> and --trust, shared by load, diff and restore
    only=""; trust=""; profile=""
    parse_flags() {
        only=""; trust=""; profile=""; rest=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --only) [ $# -ge 2 ] || { echo "--only needs a list like bar,dock,colors" >&2; exit 1; }; only=$2; shift 2 ;;
                --trust) trust=1; shift ;;
                --profile) profile=1; shift ;;
                *) rest="${rest:+$rest }$1"; shift ;;
            esac
        done
    }
    case "$sub" in
        list) need_running; ipc presets list ;;
        save)
            need_running; parse_flags "$@"
            if [ -n "$profile" ]; then ipc presets saveProfile "${rest:- }"; else ipc presets save "${rest:- }"; fi ;;
        load)
            need_running; parse_flags "$@"
            [ -n "$rest" ] || { echo "Usage: hi preset load <name|file> [--only bar,dock,colors] [--trust]" >&2; exit 1; }
            ipc presets loadWith "$(resolve "$rest")" " $only" "$([ -n "$trust" ] && echo true || echo false)" ;;
        diff)
            parse_flags "$@"
            [ -n "$rest" ] || { echo "Usage: hi preset diff <name|file> [--only parts] [--trust]" >&2; exit 1; }
            exec python3 "$py" diff "$(resolve "$rest")" --config "$cfg" --widgets-dir "$wd" --binds "$bf" ${only:+--only "$only"} ${trust:+--trust} ;;
        undo)
            need_running
            python3 "$py" undo --config "$cfg" --backup-dir "$state/preset-backups" --widgets-dir "$wd" --binds "$bf" ;;
        # hi preset dump <folder> [--profile]: a folder for git, one file per config section
        dump)
            need_running; parse_flags "$@"
            [ -n "$rest" ] || { echo "Usage: hi preset dump <folder> [--profile]" >&2; exit 1; }
            wall=$(ipc wallpaper get | head -n1)
            python3 "$py" dump "$rest" --config "$cfg" --colors "$state/colors.json" ${wall:+--wallpaper "$wall"} \
                ${profile:+--profile --widgets-dir "$wd" --binds "$bf"} ;;
        # hi preset restore <folder> [--only parts] [--trust]
        restore)
            need_running; parse_flags "$@"
            [ -n "$rest" ] || { echo "Usage: hi preset restore <folder> [--only parts] [--trust]" >&2; exit 1; }
            out=$(python3 "$py" restore "$rest" --config "$cfg" --wallpapers "$HOME/Pictures/Wallpapers/presets" --backup-dir "$state/preset-backups" \
                --widgets-dir "$wd" --binds "$bf" \
                ${only:+--only "$only"} ${trust:+--trust}) || exit 1
            wall=$(printf '%s' "$out" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("wallpaper",""))')
            mode=$(printf '%s' "$out" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("mode",""))')
            [ -z "$wall" ] || ipc wallpaper set "$wall" >/dev/null
            [ -z "$mode" ] || ipc theme setMode "$mode" >/dev/null
            echo "Restored from $rest" ;;
        *) echo "Usage: hi preset list|save [--profile] [name]|load <name|file> [--only parts] [--trust]|diff <name|file>|undo|dump <folder> [--profile]|restore <folder>" >&2; exit 1 ;;
    esac
}

widgets() {
    dir="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/widgets"
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list) need_running; out=$(ipc widgets list); if [ -n "$out" ]; then echo "$out"; else echo "No widgets in $dir (hi widgets new <name> makes one)"; fi ;;
        path) echo "$dir" ;;
        reload) need_running; ipc widgets reload ;;
        new)
            [ -n "${1:-}" ] || { echo "Usage: hi widgets new <name>   (letters, digits and _, starting with a letter)" >&2; exit 1; }
            case "$1" in [A-Za-z]*) ;; *) echo "The name must start with a letter" >&2; exit 1 ;; esac
            case "$1" in *[!A-Za-z0-9_]*) echo "The name may only have letters, digits and _" >&2; exit 1 ;; esac
            mkdir -p "$dir"
            [ -e "$dir/$1.qml" ] && { echo "$dir/$1.qml already exists" >&2; exit 1; }
            sed "s/__NAME__/$1/g" "$here/widgets/template.qml" >"$dir/$1.qml"
            echo "Made $dir/$1.qml. Add it to a bar: hi bar add mybar top $1   (or Settings > Bar)" ;;
        edit)
            [ -n "${1:-}" ] || { echo "Usage: hi widgets edit <name>" >&2; exit 1; }
            case "$1" in *[!A-Za-z0-9_]*) echo "Not a widget name: $1" >&2; exit 1 ;; esac
            "${VISUAL:-${EDITOR:-nano}}" "$dir/$1.qml" ;;
        *) echo "Usage: hi widgets list|new <name>|edit <name>|reload|path" >&2; exit 1 ;;
    esac
}

# hi script <name> <command> [seconds] [icon] [template]: a bar widget made of a command, "script#<name>"
script() {
    [ $# -ge 2 ] || { echo "Usage: hi script <name> '<command>' [seconds] [icon] [template]   e.g. hi script temp 'sensors | head -1' 10 thermostat '{}°'" >&2; exit 1; }
    need_running
    json=$(python3 -I -c '
import json, sys
name, command = sys.argv[1], sys.argv[2]
opts = {"command": command, "interval": float(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else 5}
if len(sys.argv) > 4 and sys.argv[4]:
    opts["icon"] = sys.argv[4]
if len(sys.argv) > 5 and sys.argv[5]:
    opts["template"] = sys.argv[5]
print(json.dumps(opts))' "$@") || exit 1
    ipc config map bar.instances "script#$1" " $json" >/dev/null && echo "Made script#$1. Add it to a bar: Settings > Bar, or hi bar edit" 
}

# hi dock screens <all|name...>: the screens that have a dock; hi dock own <screen> <key> <json|null>: one setting for that screen's dock
dock() {
    need_running
    sub=${1:-}
    [ $# -gt 0 ] && shift
    case "$sub" in
        screens)
            [ $# -gt 0 ] || { echo "Usage: hi dock screens <all|name...>" >&2; exit 1; }
            if [ "$1" = all ]; then list='["*"]'; else list=$(python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@"); fi
            ipc config set dock.monitors " $list" ;;
        own) [ $# -ge 3 ] || { echo "Usage: hi dock own <screen> <position|iconSize|autoHide|...> <json|null>" >&2; exit 1; }
            ipc config map dock.perScreen "$1.$2" " $3" >/dev/null && echo "Done" ;;
        on | off) ipc config set dock.enabled "$([ "$sub" = on ] && echo true || echo false)" ;;
        *) echo "Usage: hi dock on|off|screens <all|name...>|own <screen> <key> <json|null>" >&2; exit 1 ;;
    esac
}

# hi desktop screens <all|name...>: the screens that show desktop widgets; hi desktop own <screen> [off]: a layout of its own
desktop() {
    need_running
    sub=${1:-}
    [ $# -gt 0 ] && shift
    case "$sub" in
        screens)
            [ $# -gt 0 ] || { echo "Usage: hi desktop screens <all|name...>" >&2; exit 1; }
            if [ "$1" = all ]; then list='["*"]'; else list=$(python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@"); fi
            ipc config set desktop.monitors " $list" ;;
        own)
            [ -n "${1:-}" ] || { echo "Usage: hi desktop own <screen> [off]" >&2; exit 1; }
            if [ "${2:-}" = off ]; then ipc config map desktop.layouts "$1" " null" >/dev/null && echo "$1 uses the shared layout"
            else cur=$(ipc config get desktop.layout); ipc config map desktop.layouts "$1" " $cur" >/dev/null && echo "$1 has its own layout (a copy of the shared one)"; fi ;;
        edit) ipc desktop edit ;;
        done) ipc desktop done ;;
        *) echo "Usage: hi desktop screens <all|name...>|own <screen> [off]|edit|done" >&2; exit 1 ;;
    esac
}

# hi rules: "when this, do that" (see docs/RULES.md)
# hi look [list | <name> | save <name> | rm <name>]: a look is shape, surfaces, text and motion set together
look() {
    need_running
    case "${1:-list}" in
        list) ipc looks list ;;
        save) [ -n "${2:-}" ] || { echo "Usage: hi look save <name>" >&2; exit 1; }; ipc looks save "$2" ;;
        rm | remove) [ -n "${2:-}" ] || { echo "Usage: hi look rm <name>" >&2; exit 1; }; ipc looks remove "$2" ;;
        apply) [ -n "${2:-}" ] || { echo "Usage: hi look apply <name>" >&2; exit 1; }; ipc looks apply "$2" ;;
        *) ipc looks apply "$*" ;;
    esac
}

rules() {
    need_running
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list) out=$(ipc rules list); if [ -n "$out" ]; then printf '%s\n' "$out" | column -t -s "$(printf '\t')"; else echo "No rules yet: hi rules templates, hi rules add <template>, hi rules edit <id>"; fi ;;
        templates) ipc rules templates | column -t -s "$(printf '\t')" ;;
        add) [ -n "${1:-}" ] || { echo "Usage: hi rules add <template>   (hi rules templates)" >&2; exit 1; }; ipc rules addTemplate "$1" ;;
        rm | remove) [ -n "${1:-}" ] || { echo "Usage: hi rules rm <id>" >&2; exit 1; }; ipc rules remove "$1" ;;
        on) [ -n "${1:-}" ] || { echo "Usage: hi rules on <id>" >&2; exit 1; }; ipc rules enable "$1" true ;;
        off) [ -n "${1:-}" ] || { echo "Usage: hi rules off <id>" >&2; exit 1; }; ipc rules enable "$1" false ;;
        show) [ -n "${1:-}" ] || { echo "Usage: hi rules show <id>" >&2; exit 1; }; ipc rules get "$1" ;;
        facts) ipc rules facts ;;
        check) out=$(ipc rules check); if [ -n "$out" ]; then echo "$out"; exit 1; else echo "All rules are fine."; fi ;;
        # hi rules edit <id>: the rule in $EDITOR (a new id starts from a skeleton); saved when the file is valid JSON
        edit)
            [ -n "${1:-}" ] || { echo "Usage: hi rules edit <id>" >&2; exit 1; }
            case "$1" in *[!A-Za-z0-9_-]*) echo "The id is letters, digits, - and _" >&2; exit 1 ;; esac
            tmp=$(mktemp "${TMPDIR:-/tmp}/hi-rule-XXXXXX.json") || exit 1
            cur=$(ipc rules get "$1")
            case "$cur" in "No such rule"*) printf '{\n  "id": "%s",\n  "name": "",\n  "when": { "battery": "discharging" },\n  "then": [ { "notify": "on battery" } ],\n  "else": []\n}\n' "$1" >"$tmp" ;; *) printf '%s\n' "$cur" >"$tmp" ;; esac
            "${VISUAL:-${EDITOR:-nano}}" "$tmp"
            json=$(python3 -I -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))' "$tmp") || { echo "Not valid JSON; nothing saved (file kept: $tmp)" >&2; exit 1; }
            rm -f "$tmp"
            ipc rules put "$json" ;;
        *) echo "Usage: hi rules list|templates|add <template>|edit <id>|show <id>|on <id>|off <id>|rm <id>|facts|check" >&2; exit 1 ;;
    esac
}

update() {
    [ -x "$repo/update.sh" ] || { echo "update.sh not found in $repo" >&2; exit 1; }
    exec "$repo/update.sh" "$@"
}

# The repo's scripts: hi install re-runs the installer (repairs the links and the Hyprland line), hi uninstall removes it.
repo_script() { # repo_script <file> [args]
    [ -x "$repo/$1" ] || { echo "$1 not found in $repo" >&2; exit 1; }
    f=$1; shift
    exec "$repo/$f" "$@"
}

version_line() {
    # The pacman package: its version (.package is "<name> <version>"), there's no git there.
    if [ -f "$repo/.package" ]; then
        echo "hi-shell $(cut -d' ' -f2 "$repo/.package") (pacman package $(cut -d' ' -f1 "$repo/.package"))"
        return
    fi
    v=$(git -C "$repo" describe --tags --always 2>/dev/null) || v="unknown"
    d=$(git -C "$repo" log -1 --format=%cs 2>/dev/null)
    echo "hi-shell $v${d:+ ($d)}"
}

version() {
    version_line
    echo "channel   $(channel_get)"
    echo "repo      $repo"
    have qs && echo "quickshell $(qs --version 2>/dev/null | head -n1)"
    have hyprctl && echo "hyprland  $(hyprctl version -j 2>/dev/null | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("tag", "?"))' 2>/dev/null || echo '?')"
}

# update.channel in the config: git (latest main) or release (latest tag), what update.sh follows
channel_get() {
    python3 -I -c 'import json,sys; c=json.load(open(sys.argv[1])).get("update", {}).get("channel"); print("release" if c == "release" else "git")' "$cfg" 2>/dev/null || echo git
}

channel() {
    case "${1:-}" in
        "") channel_get ;;
        git | release)
            [ -f "$repo/.package" ] && { echo "hi-shell is installed with pacman: it updates with the package, not from a channel" >&2; exit 1; }
            if running; then ipc config set update.channel "\"$1\"" >/dev/null
            else
                # The shell isn't there to save it: the file, keeping the rest.
                python3 -I - "$cfg" "$1" <<'PY' || exit 1
import json, os, sys
path, channel = sys.argv[1:3]
try:
    with open(path) as f:
        data = json.load(f)
except (OSError, ValueError):
    data = {}
data.setdefault("update", {})["channel"] = channel
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY
            fi
            echo "Updates come from: $1 (hi update to get them)" ;;
        *) echo "Usage: hi channel [git|release]" >&2; exit 1 ;;
    esac
}

is_int() { case "$1" in "" | *[!0-9]*) return 1 ;; *) return 0 ;; esac; }

session() {
    need_running
    case "${1:-}" in
        "") ipc session toggleScreen ;;
        suspend | sleep) ipc session suspend ;;
        hibernate) ipc session hibernate ;;
        reboot | restart) ipc session reboot ;;
        poweroff | shutdown | off) ipc session poweroff ;;
        logout | exit) ipc session logout ;;
        lock) ipc session lock ;;
        *) echo "Usage: hi session [suspend|hibernate|reboot|poweroff|logout|lock]" >&2; exit 1 ;;
    esac
}

# hi boot: the boot entries (bootctl); hi boot <id>: reboot into one of them
boot() {
    need_running
    case "${1:-list}" in
        list) ipc boot list ;;
        *) ipc boot reboot "$1" ;;
    esac
}

# hi shot: a screenshot of a region (the default), the whole screen, OCR, translate, a recording
shot() {
    need_running
    case "${1:-region}" in
        region) ipc region screenshot ;;
        full | fullscreen | screen) ipc region fullscreen ;;
        ocr | text) ipc region ocr ;;
        translate) ipc region translate ;;
        record) ipc region record ;;
        stop) ipc region stop ;;
        cancel) ipc region cancel ;;
        *) echo "Usage: hi shot [region|full|ocr|translate|record|stop|cancel]" >&2; exit 1 ;;
    esac
}

brightness() {
    need_running
    case "${1:-}" in
        up | +) ipc brightness increment ;;
        down | -) ipc brightness decrement ;;
        *)
            p=${1%\%}
            is_int "$p" && [ "$p" -le 100 ] || { echo "Usage: hi brightness up|down|<0-100>" >&2; exit 1; }
            ipc brightness set "$p" ;;
    esac
}

display() {
    need_running
    case "${1:-toggle}" in
        toggle) ipc display toggle ;;
        next) ipc display next ;;
        internal | mirror | left | right | external) ipc display set "$1" ;;
        screens | list) ipc displays screens ;;
        *) echo "Usage: hi display [toggle|next|internal|mirror|left|right|external|screens]" >&2; exit 1 ;;
    esac
}

powersave() {
    need_running
    case "${1:-toggle}" in
        on | off | toggle | status) ipc powersaving "$1" ;;
        *) echo "Usage: hi powersave [on|off|toggle|status]" >&2; exit 1 ;;
    esac
}

notif() {
    need_running
    case "${1:-list}" in
        list) out=$(ipc notifications list); if [ -n "$out" ]; then echo "$out"; else echo "No notifications."; fi ;;
        clear) ipc notifications clear ;;
        dnd) ipc notifications toggleDnd ;;
        dismiss | rm)
            is_int "${2:-}" || { echo "Usage: hi notif dismiss <id>   (the ids: hi notif list)" >&2; exit 1; }
            ipc notifications dismiss "$2" ;;
        *) echo "Usage: hi notif [list|clear|dnd|dismiss <id>]" >&2; exit 1 ;;
    esac
}

todo() {
    need_running
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list)
            out=$(ipc todo list)
            if [ -n "$out" ]; then printf '%s\n' "$out" | awk '{ printf "%3d  %s\n", NR, $0 }'; else echo "Nothing to do: hi todo add <text>"; fi ;;
        add) [ $# -gt 0 ] || { echo "Usage: hi todo add <text>" >&2; exit 1; }; ipc todo add "$*" ;;
        done | toggle | x)
            is_int "${1:-}" && [ "$1" -ge 1 ] || { echo "Usage: hi todo done <number>   (the numbers: hi todo list)" >&2; exit 1; }
            ipc todo toggle "$1" ;;
        *) echo "Usage: hi todo [list|add <text>|done <n>]" >&2; exit 1 ;;
    esac
}

focus() {
    need_running
    sub=${1:-status}
    [ $# -gt 0 ] && shift
    case "$sub" in
        status) ipc focus status ;;
        start | stop | abort) ipc focus "$sub" ;;
        task) [ $# -gt 0 ] || { echo "Usage: hi focus task <text>" >&2; exit 1; }; ipc focus addTask "$*" ;;
        profile) [ -n "${1:-}" ] || { echo "Usage: hi focus profile <id>" >&2; exit 1; }; ipc focus profile "$1" ;;
        settings) ipc focus settings ;;
        *) echo "Usage: hi focus [status|start|stop|abort|task <text>|profile <id>|settings]" >&2; exit 1 ;;
    esac
}

screentime() {
    need_running
    case "${1:-today}" in
        today) ipc screentime today | python3 -I -c '
import json, sys
rows = json.load(sys.stdin) or []
for r in rows:
    m = int(r.get("seconds", 0)) // 60
    print("%5s  %s" % ("%d:%02d" % divmod(m, 60), r.get("app", "?")))
print("%5s  total" % ("%d:%02d" % divmod(sum(int(r.get("seconds", 0)) for r in rows) // 60, 60)))' ;;
        limits) ipc screentime limits ;;
        limit)
            [ -n "${2:-}" ] && is_int "${3:-}" || { echo "Usage: hi screentime limit <app> <minutes>   (0 = no limit)" >&2; exit 1; }
            ipc screentime limit "$2" "$3" ;;
        *) echo "Usage: hi screentime [today|limits|limit <app> <minutes>]" >&2; exit 1 ;;
    esac
}

SOUND_PACKS="miui samsung iphone windows win7 winxp android"
sounds() {
    case " $SOUND_PACKS " in
        *" ${1:-} "*) ;;
        *) echo "Usage: hi sounds <pack>   packs: $SOUND_PACKS (downloaded into ~/.local/share/hi-shell/sounds)" >&2; exit 1 ;;
    esac
    have curl || { echo "curl isn't installed" >&2; exit 1; }
    sh "$here/sound-packs.sh" "$1" && echo "Downloaded the $1 sounds. Pick them in Settings > Sounds."
}

# --- Completions ---
# One list of words for every shell: the completion scripts call `hi __complete <words before the cursor>`.
COMMANDS="start stop restart status log doctor version update channel install uninstall completions config settings
launcher apps overview calendar weather processes sidebar bar lock session boot wait present ask theme wallpaper preset
look rules dock desktop widgets script shot brightness display powersave notif todo focus screentime sounds play pause
next prev qr keybinds ipc help"
SETTINGS_PAGES="search quick general bar desktop lock interface sounds services hyprland autostart defaultapps screentime rules about"
SCHEMES="dark light toggle seed tonal-spot content expressive fidelity fruit-salad monochrome neutral rainbow vibrant"

subcommands() {
    case "$1" in
        config | cfg) echo "get set reset search edit path reload" ;;
        settings) echo "$SETTINGS_PAGES" ;;
        sidebar) echo "left right" ;;
        bar) echo "show hide toggle edit done list add rm monitor instance" ;;
        theme) echo "$SCHEMES" ;;
        wallpaper | wall) echo "random select get screen" ;;
        preset | presets) echo "list save load diff undo dump restore" ;;
        look | looks) echo "list save rm apply" ;;
        rules | rule) echo "list templates add edit show on off rm facts check" ;;
        dock) echo "on off screens own" ;;
        desktop) echo "screens own edit done" ;;
        widgets | widget) echo "list new edit reload path" ;;
        session | power) echo "suspend hibernate reboot poweroff logout lock" ;;
        boot) echo "list" ;;
        shot) echo "region full ocr translate record stop cancel" ;;
        brightness) echo "up down" ;;
        display) echo "toggle next internal mirror left right external screens" ;;
        powersave) echo "on off toggle status" ;;
        notif | notifications) echo "list clear dnd dismiss" ;;
        todo) echo "list add done" ;;
        focus) echo "status start stop abort task profile settings" ;;
        screentime) echo "today limits limit" ;;
        sounds) echo "$SOUND_PACKS" ;;
        channel) echo "git release" ;;
        update) echo "--check" ;;
        uninstall) echo "--purge" ;;
        install) echo "--yes --no-deps --no-start --no-dots --with-apps --channel=git --channel=release --only= --skip=" ;;
        completions) echo "bash zsh fish" ;;
        log | logs) echo "-f" ;;
    esac
}

# One word per line (fish splits on lines).
complete_words() {
    # shellcheck disable=SC2086 # the lists are split on purpose
    if [ $# -eq 0 ]; then printf '%s\n' $COMMANDS; return; fi
    c=$1; shift
    # shellcheck disable=SC2046
    if [ $# -eq 0 ]; then printf '%s\n' $(subcommands "$c"); return; fi
    # Option names for hi config get / set / reset (from the config reference, no running shell needed).
    case "$c $1 $#" in
        "config get 1" | "config set 1" | "config reset 1" | "cfg get 1" | "cfg set 1" | "cfg reset 1")
            python3 -I "$repo/tools/config_meta.py" names 2>/dev/null ;;
    esac
}

completions() {
    case "${1:-}" in
        bash | zsh | fish) cat "$here/completions/hi.$1" ;;
        *) echo "Usage: hi completions bash|zsh|fish   (e.g. hi completions zsh > ~/.zfunc/_hi)" >&2; exit 1 ;;
    esac
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
    start) start ;;
    stop) stop ;;
    restart) sleep 0.4; stop; sleep 1; start ;;
    status) status ;;
    log | logs) log "$@" ;;
    doctor) doctor ;;
    version | --version | -v) version ;;
    update) update "$@" ;;
    channel) channel "$@" ;;
    install | reinstall | repair) repo_script install.sh "$@" ;;
    uninstall) repo_script uninstall.sh "$@" ;;
    completions | completion) completions "$@" ;;
    __complete) complete_words "$@" ;;
    config | cfg) config "$@" ;;
    settings | set-up)
        need_running
        case "${1:-}" in
            search) shift; ipc settings search " $*" ;;
            "") ipc settings toggle ;;
            *) ipc settings open "$1" ;;
        esac ;;
    launcher | run) need_running; if [ $# -gt 0 ]; then ipc launcher search "$*"; ipc launcher open; else ipc launcher toggle; fi ;;
    apps) need_running; ipc appgrid toggle ;;
    overview) need_running; ipc overview toggle ;;
    calendar) need_running; ipc calendar toggle ;;
    weather) need_running; ipc weather refresh; ipc weatherDetails toggle ;;
    processes | top) need_running; ipc processes toggle ;;
    sidebar) sidebar "$@" ;;
    bar) barcmd "$@" ;;
    lock) need_running; ipc lock lock ;;
    session | power) session "$@" ;;
    boot) boot "$@" ;;
    shot | screenshot) shot "$@" ;;
    ocr) shot ocr ;;
    record) shot record ;;
    brightness | bright) brightness "$@" ;;
    display) display "$@" ;;
    powersave | powersaving) powersave "$@" ;;
    notif | notifications | notify) notif "$@" ;;
    todo) todo "$@" ;;
    focus) focus "$@" ;;
    screentime) screentime "$@" ;;
    sounds) sounds "$@" ;;
    wait) need_running; ipc waitmode toggle ;;
    present | presentation) need_running; ipc presentation toggle ;;
    ask | ai) need_running; if [ $# -gt 0 ]; then ipc ai ask "$*"; else ipc ai toggle; fi ;;
    theme) theme "$@" ;;
    wallpaper | wall) wallpaper "$@" ;;
    preset | presets) preset "$@" ;;
    rules | rule) rules "$@" ;;
    look | looks) look "$@" ;;
    dock) dock "$@" ;;
    desktop) desktop "$@" ;;
    widgets | widget) widgets "$@" ;;
    script) script "$@" ;;
    play | pause | toggle-play) need_running; ipc mpris playPause ;;
    next) need_running; ipc mpris next ;;
    prev | previous) need_running; ipc mpris previous ;;
    qr) qr "$@" ;;
    keybinds | keys) keybinds "$@" ;;
    ipc)
        if [ $# -eq 0 ]; then exec qs -c hi-shell ipc show; fi
        exec qs -c hi-shell ipc call "$@"
        ;;
    help | -h | --help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
