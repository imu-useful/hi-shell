#!/bin/sh
# hi-shell command line (also installed as `hi`).
#
#   Shell        hi start | stop | restart | status | log [-f] | doctor | update
#   Panels       hi settings [page] | launcher | apps | overview | calendar | weather | processes
#                hi sidebar [left|right] | bar [show|hide|toggle|edit|done|list|add|rm|monitor|instance] | lock | session | wait | present
#                hi ask <prompt>    hi theme [dark|light|toggle|<scheme>|seed <#rrggbb>]    hi wallpaper [random|<file>]
#   Config       hi config get <option|section>      hi config set <option> <value>
#                hi config reset [option|section]    hi config edit | path | reload
#   Widgets      hi widgets [list|new <name>|edit <name>|reload|path]   hi script <name> '<command>' [seconds] [icon] [template]
#   Presets      hi preset list | save <name> | load <file>
#   Media        hi play | pause | next | prev
#   Other        hi qr [text] | keybinds [word] | ipc [<target> <function> [args]] | help
#
# install.sh links this file to ~/.local/bin/hi-shell and ~/.local/bin/hi.
set -u

have() { command -v "$1" >/dev/null 2>&1; }

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

doctor() {
    bad=0
    row() { # status, name, note
        printf '  %s %-14s %s\n' "$1" "$2" "$3"
    }
    echo "Shell"
    if qs -c hi-shell list 2>/dev/null | grep -q 'Process ID'; then
        row "✔" "running" ""
        errors=$(qs -c hi-shell log 2>/dev/null | grep -c ' ERROR')
        if [ "$errors" -gt 0 ]; then row "✘" "log" "$errors errors: qs -c hi-shell log | grep ERROR"; bad=1; else row "✔" "log" "no errors"; fi
    else
        row "✘" "running" "not running: start it with run.sh or log in again"; bad=1
    fi
    echo "Required"
    for p in qs hyprctl python3; do
        if have "$p"; then row "✔" "$p" ""; else row "✘" "$p" "missing"; bad=1; fi
    done
    echo "Optional (the feature that needs it)"
    for pair in "matugen:colors from the wallpaper" "claude:AI chat with Claude" "cliphist:clipboard history" \
        "wl-copy:clipboard" "qalc:calculator" "grim:screenshots" "slurp:screenshots" "tesseract:OCR" \
        "wf-recorder:screen recording" "cava:visualizer" "hyprlock:lock screen" "hypridle:idle lock and sleep" \
        "hyprsunset:night light" "hyprpicker:color picker" "brightnessctl:brightness" "magick:wallpaper thumbnails" \
        "fd:file search in the launcher (~)" "qrencode:hi-shell qr" "bootctl:Reboot to…" "trans:translator"; do
        p=${pair%%:*}
        if have "$p"; then row "✔" "$p" ""; else row "–" "$p" "missing: ${pair#*:}"; fi
    done
    [ "$bad" -eq 0 ] && echo "All good." || echo "Something needs attention (✘ above)."
    return "$bad"
}

qr() {
    have qrencode || { echo "qrencode isn't installed (pacman -S qrencode)" >&2; return 1; }
    if [ $# -gt 0 ]; then
        text="$*"
    elif have wl-paste; then
        text=$(wl-paste --no-newline 2>/dev/null)
    else
        text=""
    fi
    [ -n "$text" ] || { echo "Nothing to encode: give some text or copy it first." >&2; return 1; }
    qrencode -t ansiutf8 -m 1 -- "$text"
}

keybinds() {
    have hyprctl || { echo "hyprctl not found" >&2; return 1; }
    have python3 || { echo "python3 not found" >&2; return 1; }
    hyprctl binds -j | python3 -I -c '
import json, sys
word = " ".join(sys.argv[1:]).lower()
mods = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]
rows = []
for b in json.load(sys.stdin):
    if b.get("submap"):
        continue
    keys = " + ".join([n for bit, n in mods if b.get("modmask", 0) & bit] + [b.get("key") or "code:%s" % b.get("keycode")])
    desc = b.get("description") or b.get("dispatcher", "")
    if word in (keys + " " + desc).lower():
        rows.append((keys, desc))
width = max([len(k) for k, _ in rows] or [0])
for keys, desc in sorted(rows):
    print("%-*s  %s" % (width, keys, desc))
' "$@"
}

here=$(dirname "$(readlink -f "$0")")
repo=$(dirname "$here")
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/config.json"

# A value that starts with [ is mangled by qs ipc (["a"] arrives as a); the commands below put a space before JSON.
ipc() { qs -c hi-shell ipc call "$@"; }

running() { qs -c hi-shell list 2>/dev/null | grep -q 'Process ID'; }

need_running() {
    running || { echo "hi-shell isn't running: hi start" >&2; exit 1; }
}

start() {
    if running; then echo "Already running."; return 0; fi
    # run.sh makes the icon font and picks the Vulkan renderer; -d detaches.
    if [ -x "$repo/run.sh" ]; then "$repo/run.sh" -d; else qs -c hi-shell -d; fi
    echo "Started."
}

stop() { qs -c hi-shell kill >/dev/null 2>&1 && echo "Stopped." || echo "Not running."; }

status() {
    if running; then
        qs -c hi-shell list 2>/dev/null | grep -E 'Process ID|Launch time|Config path' | sed 's/^ *//'
        echo "Errors in the log: $(qs -c hi-shell log 2>/dev/null | grep -c ' ERROR')"
    else
        echo "Not running."
        return 1
    fi
}

log() {
    if [ "${1:-}" = "-f" ]; then exec qs -c hi-shell log -f; fi
    qs -c hi-shell log 2>&1 | tail -n "${1:-60}"
}

config() {
    sub=${1:-help}
    [ $# -gt 0 ] && shift
    case "$sub" in
        get) need_running; ipc config get "${1:-}" ;;
        set)
            [ $# -ge 2 ] || { echo "Usage: hi config set <option> <value>   (value is JSON: 40, true, \"top\"; a bare word is a string)" >&2; exit 1; }
            need_running; opt=$1; shift; ipc config set "$opt" " $*" ;;
        reset) need_running; ipc config reset "${1:-}" ;;
        path) echo "$cfg" ;;
        edit) "${VISUAL:-${EDITOR:-nano}}" "$cfg" ;;
        reload) need_running; touch "$cfg"; echo "Touched $cfg: the shell reloads it." ;;
        *) echo "Usage: hi config get|set|reset|edit|path|reload" >&2; exit 1 ;;
    esac
}

sidebar() {
    need_running
    case "${1:-right}" in
        left | l) ipc sidebarLeft toggle ;;
        *) ipc sidebarRight toggle ;;
    esac
}

barcmd() {
    need_running
    sub=${1:-toggle}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list) ipc config get bar.extra; echo "per screen:"; ipc config get bar.monitors; echo "copies:"; ipc config get bar.instances ;;
        # hi bar add <id> [position] [widgets...]: an extra bar, its widgets in the center
        add)
            [ -n "${1:-}" ] || { echo "Usage: hi bar add <id> [top|bottom|left|right] [widget...]" >&2; exit 1; }
            json=$(python3 -I -c '
import json, sys
id_, pos, widgets = sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "bottom", sys.argv[3:]
print(json.dumps({"id": id_, "position": pos, "center": widgets}))' "$@") || exit 1
            ipc config listput bar.extra "$json" >/dev/null && echo "Added the bar $1" ;;
        rm | remove) [ -n "${1:-}" ] || { echo "Usage: hi bar rm <id>" >&2; exit 1; }; ipc config listdel bar.extra "$1" >/dev/null && echo "Removed the bar $1" ;;
        # hi bar monitor <screen> <key> <json>: override one setting of the main bar on a screen (null = back to the default)
        monitor)
            [ $# -ge 3 ] || { echo "Usage: hi bar monitor <screen> <enabled|position|style|height|margin|left|center|right> <json|null>   (screens: hyprctl monitors)" >&2; exit 1; }
            ipc config map bar.monitors "$1.$2" " $3" >/dev/null && echo "Done" ;;
        # hi bar instance <type#name> <json>: a copy of a widget with options of its own, e.g. 'zoneClock#tokyo' '{"zone":"Asia/Tokyo"}'
        instance)
            [ $# -ge 2 ] || { echo "Usage: hi bar instance <type#name> <json|null>   e.g. 'resources#disks' '{\"shown\":[\"disk\"]}'" >&2; exit 1; }
            ipc config map bar.instances "$1" " $2" >/dev/null && echo "Done" ;;
        edit) ipc bar edit ;;
        done) ipc bar done ;;
        *) ipc bar "$sub" ;;
    esac
}

theme() {
    need_running
    case "${1:-toggle}" in
        dark | light) ipc theme setMode "$1" ;;
        seed) [ -n "${2:-}" ] || { echo "Usage: hi theme seed <#rrggbb|wallpaper>" >&2; exit 1; }
            case "$2" in wallpaper | none) c='""' ;; *#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) c="\"$2\"" ;; *) echo "A color looks like #rrggbb" >&2; exit 1 ;; esac
            ipc config set appearance.seedColor "$c" ;;
        toggle) ipc theme toggleMode ;;
        *) ipc theme setScheme "$1" ;;
    esac
}

wallpaper() {
    need_running
    case "${1:-select}" in
        random) ipc wallpaper random ;;
        select) ipc wallpaper toggleSelector ;;
        get) ipc wallpaper get ;;
        *) ipc wallpaper set "$(readlink -f "$1")" ;;
    esac
}

preset() {
    need_running
    case "${1:-list}" in
        list) ipc presets list ;;
        save) [ -n "${2:-}" ] || { echo "Usage: hi preset save <name>" >&2; exit 1; }; ipc presets save "$2" ;;
        load) [ -n "${2:-}" ] || { echo "Usage: hi preset load <file>" >&2; exit 1; }; ipc presets load "$(readlink -f "$2")" ;;
        *) echo "Usage: hi preset list|save <name>|load <file>" >&2; exit 1 ;;
    esac
}

widgets() {
    dir="${XDG_CONFIG_HOME:-$HOME/.config}/hi-shell/widgets"
    sub=${1:-list}
    [ $# -gt 0 ] && shift
    case "$sub" in
        list) need_running; out=$(ipc widgets list); if [ -n "$out" ]; then echo "$out"; else echo "No widgets in $dir (hi widgets new <name> makes one)"; fi ;;
        path) echo "$dir" ;;
        reload) need_running; ipc widgets reload ;;
        new)
            [ -n "${1:-}" ] || { echo "Usage: hi widgets new <name>   (letters, digits and _, starting with a letter)" >&2; exit 1; }
            case "$1" in [A-Za-z]*) ;; *) echo "The name must start with a letter" >&2; exit 1 ;; esac
            case "$1" in *[!A-Za-z0-9_]*) echo "The name may only have letters, digits and _" >&2; exit 1 ;; esac
            mkdir -p "$dir"
            [ -e "$dir/$1.qml" ] && { echo "$dir/$1.qml already exists" >&2; exit 1; }
            sed "s/__NAME__/$1/g" "$here/widgets/template.qml" >"$dir/$1.qml"
            echo "Made $dir/$1.qml. Add it to a bar: hi bar add mybar top $1   (or Settings > Bar)" ;;
        edit)
            [ -n "${1:-}" ] || { echo "Usage: hi widgets edit <name>" >&2; exit 1; }
            case "$1" in *[!A-Za-z0-9_]*) echo "Not a widget name: $1" >&2; exit 1 ;; esac
            "${VISUAL:-${EDITOR:-nano}}" "$dir/$1.qml" ;;
        *) echo "Usage: hi widgets list|new <name>|edit <name>|reload|path" >&2; exit 1 ;;
    esac
}

# hi script <name> <command> [seconds] [icon] [template]: a bar widget made of a command, "script#<name>"
script() {
    [ $# -ge 2 ] || { echo "Usage: hi script <name> '<command>' [seconds] [icon] [template]   e.g. hi script temp 'sensors | head -1' 10 thermostat '{}°'" >&2; exit 1; }
    need_running
    json=$(python3 -I -c '
import json, sys
name, command = sys.argv[1], sys.argv[2]
opts = {"command": command, "interval": float(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else 5}
if len(sys.argv) > 4 and sys.argv[4]:
    opts["icon"] = sys.argv[4]
if len(sys.argv) > 5 and sys.argv[5]:
    opts["template"] = sys.argv[5]
print(json.dumps(opts))' "$@") || exit 1
    ipc config map bar.instances "script#$1" " $json" >/dev/null && echo "Made script#$1. Add it to a bar: Settings > Bar, or hi bar edit" 
}

update() {
    [ -x "$repo/update.sh" ] || { echo "update.sh not found in $repo" >&2; exit 1; }
    exec "$repo/update.sh" "$@"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
    start) start ;;
    stop) stop ;;
    restart) sleep 0.4; stop; sleep 1; start ;;
    status) status ;;
    log | logs) log "$@" ;;
    doctor) doctor ;;
    update) update "$@" ;;
    config | cfg) config "$@" ;;
    settings | set-up) need_running; if [ $# -gt 0 ]; then ipc settings open "$1"; else ipc settings toggle; fi ;;
    launcher | run) need_running; if [ $# -gt 0 ]; then ipc launcher search "$*"; ipc launcher open; else ipc launcher toggle; fi ;;
    apps) need_running; ipc appgrid toggle ;;
    overview) need_running; ipc overview toggle ;;
    calendar) need_running; ipc calendar toggle ;;
    weather) need_running; ipc weather refresh; ipc weatherDetails toggle ;;
    processes | top) need_running; ipc processes toggle ;;
    sidebar) sidebar "$@" ;;
    bar) barcmd "$@" ;;
    lock) need_running; ipc lock lock ;;
    session | power) need_running; ipc session toggleScreen ;;
    wait) need_running; ipc waitmode toggle ;;
    present | presentation) need_running; ipc presentation toggle ;;
    ask | ai) need_running; if [ $# -gt 0 ]; then ipc ai ask "$*"; else ipc ai toggle; fi ;;
    theme) theme "$@" ;;
    wallpaper | wall) wallpaper "$@" ;;
    preset | presets) preset "$@" ;;
    widgets | widget) widgets "$@" ;;
    script) script "$@" ;;
    play | pause | toggle-play) need_running; ipc mpris playPause ;;
    next) need_running; ipc mpris next ;;
    prev | previous) need_running; ipc mpris previous ;;
    qr) qr "$@" ;;
    keybinds | keys) keybinds "$@" ;;
    ipc)
        if [ $# -eq 0 ]; then exec qs -c hi-shell ipc show; fi
        exec qs -c hi-shell ipc call "$@"
        ;;
    help | -h | --help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
