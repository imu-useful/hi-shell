pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.common

// The lock screen: hyprlock with a config generated from hi-shell's look
// (~/.config/hi-shell/hyprlock.conf): the current wallpaper blurred behind a big
// clock, the date and a greeting in the interface language, the avatar, a Material
// password field, now playing, battery and keyboard layout. Rewritten whenever the
// wallpaper, palette, fonts or language change. Session.lock() runs it.
Singleton {
    id: root

    readonly property string path: `${Config.dir}/hyprlock.conf`
    // Falls back to hyprlock's own config if this one fails, so locking never fails.
    readonly property string command: `pidof hyprlock || hyprlock -c "${path}" || hyprlock`

    function lock() {
        writeNow();
        Quickshell.execDetached(["sh", "-c", command]);
    }

    // Qt color -> hyprlock rgba(RRGGBBAA)
    function rgba(c, alpha) {
        const h = v => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0");
        return `rgba(${h(c.r)}${h(c.g)}${h(c.b)}${h(alpha ?? c.a)})`;
    }

    // Shell-quoted for hyprlock's cmd[] labels (single quotes inside the value).
    // (hyprlang evaluates {{ }} as arithmetic, so the commands avoid it.)
    function sq(text) {
        return text.replace(/'/g, "'\\''");
    }

    readonly property string text: {
        const font = Appearance.font.main;
        const icons = Appearance.font.icon;
        const wallpaper = Wallpapers.current;
        const lc = (Translation.code === "ru" ? "ru_RU" : Translation.code === "zh" ? "zh_CN" : "en_US") + ".UTF-8";
        const tr = s => sq(Translation.tr(s));
        const primary = rgba(Colors.m3primary);
        const onSurface = rgba(Colors.m3onSurface);
        const muted = rgba(Colors.m3onSurfaceVariant);

        return `# Generated by hi-shell (services/LockScreen.qml); edits here are overwritten.

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = emphasized, 0.05, 0.7, 0.1, 1
    animation = fadeIn, 1, 5, emphasized
    animation = fadeOut, 1, 4, emphasized
    animation = inputFieldDots, 1, 2, emphasized
    animation = inputFieldColors, 1, 3, emphasized
}

background {
    monitor =
    ${wallpaper ? `path = ${wallpaper}` : ""}
    color = ${rgba(Colors.m3surface)}
    blur_passes = 3
    blur_size = 8
    brightness = 0.55
    vibrancy = 0.2
}

# --- Clock and date ---
label {
    monitor =
    text = $TIME
    color = ${primary}
    font_size = 120
    font_family = ${font} Bold
    position = 0, 270
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 6
}
label {
    monitor =
    text = cmd[update:30000] LC_TIME=${lc} date +'%A, %-d %B' | sed 's/^./\\U&/'
    color = ${onSurface}
    font_size = 22
    font_family = ${font}
    position = 0, 160
    halign = center
    valign = center
    shadow_passes = 1
}

# --- Avatar, greeting, password ---
shape {
    monitor =
    size = 128, 128
    rounding = -1
    color = ${rgba(Colors.m3primary, 0.35)}
    position = 0, -10
    halign = center
    valign = center
}
image {
    monitor =
    path = ${Paths.home}/.face
    size = 116
    rounding = -1
    border_size = 0
    position = 0, -10
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] h=$(date +%-H); if [ $h -lt 5 ]; then g='${tr("Good night")}'; elif [ $h -lt 12 ]; then g='${tr("Good morning")}'; elif [ $h -lt 18 ]; then g='${tr("Good afternoon")}'; else g='${tr("Good evening")}'; fi; echo "$g, $USER"
    color = ${onSurface}
    font_size = 18
    font_family = ${font} Medium
    position = 0, -110
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 320, 56
    rounding = -1
    outline_thickness = 2
    outer_color = ${rgba(Colors.m3outline, 0.6)}
    inner_color = ${rgba(Colors.m3surfaceContainerHigh, 0.85)}
    font_color = ${onSurface}
    font_family = ${font}
    check_color = ${rgba(Colors.m3tertiary)}
    fail_color = ${rgba(Colors.m3error)}
    capslock_color = ${rgba(Colors.m3tertiary)}
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    fade_on_empty = false
    placeholder_text = <span foreground="##${rgba(Colors.m3onSurfaceVariant).slice(5, 11)}">${Translation.tr("Password")}</span>
    fail_text = ${Translation.tr("Wrong password")} ($ATTEMPTS)
    position = 0, -180
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:500] [ "$(cat /sys/class/leds/*capslock/brightness 2>/dev/null | head -1)" = 1 ] && echo '${tr("Caps Lock is on")}' || echo ''
    color = ${rgba(Colors.m3tertiary)}
    font_size = 13
    font_family = ${font}
    position = 0, -235
    halign = center
    valign = center
}

# --- Now playing ---
label {
    monitor =
    text = cmd[update:2000] [ "$(playerctl status 2>/dev/null)" = Playing ] && echo music_note || echo ''
    color = ${primary}
    font_size = 20
    font_family = ${icons}
    position = 0, 70
    halign = center
    valign = bottom
}
label {
    monitor =
    text = cmd[update:2000] [ "$(playerctl status 2>/dev/null)" = Playing ] && echo "$(playerctl metadata title 2>/dev/null) · $(playerctl metadata artist 2>/dev/null)" | cut -c1-60 || echo ''
    color = ${muted}
    font_size = 14
    font_family = ${font}
    position = 0, 40
    halign = center
    valign = bottom
}

# --- Battery and layout ---
label {
    monitor =
    text = cmd[update:30000] c=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1); [ -n "$c" ] && echo "$c%" || echo ''
    color = ${muted}
    font_size = 14
    font_family = ${font}
    position = -32, 32
    halign = right
    valign = bottom
}
label {
    monitor =
    text = $LAYOUT
    color = ${muted}
    font_size = 14
    font_family = ${font}
    position = -100, 32
    halign = right
    valign = bottom
}
`;
    }

    function writeNow() {
        writeTimer.stop();
        file.setText(text);
    }

    // Coalesce bursts (palette and wallpaper change together).
    onTextChanged: writeTimer.restart()
    Timer {
        id: writeTimer
        interval: 1000
        onTriggered: root.writeNow()
    }

    FileView {
        id: file
        path: root.path
        printErrors: false
        blockLoading: true
    }

    Component.onCompleted: writeTimer.restart()
}
