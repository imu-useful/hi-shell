pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.common
import qs.services

// Idle lock / screen off / suspend timers. Off by default: your own hypridle config stays in charge.
// With Settings > Lock screen > Idle on, hi-shell runs hypridle with ~/.config/hi-shell/hypridle.conf,
// made from the minutes in the settings (different ones on battery if asked).
Singleton {
    id: root

    readonly property var o: Config.options.idle
    readonly property string path: `${Config.dir}/hypridle.conf`
    readonly property bool useBattery: o.separateBattery && Battery.available && Battery.onBattery
    readonly property int lockMin: useBattery ? o.batLockMin : o.lockMin
    readonly property int screenOffMin: useBattery ? o.batScreenOffMin : o.screenOffMin
    readonly property int suspendMin: useBattery ? o.batSuspendMin : o.suspendMin
    property bool started: false

    readonly property string lockCommand: LockScreen.customCommand !== "" ? LockScreen.customCommand : LockScreen.command

    function dpms(action) {
        return "hyprctl dispatch 'hl.dsp.dpms({ action = \"" + action + "\" })'";
    }

    readonly property string text: {
        const listener = (min, onTimeout, onResume) => min > 0 ? `
listener {
    timeout = ${min * 60}
    on-timeout = ${onTimeout}${onResume ? `\n    on-resume = ${onResume}` : ""}
}
` : "";
        return `# Generated by hi-shell (services/Idle.qml); edits here are overwritten.
# Settings > Lock screen > Idle.
general {
    lock_cmd = ${lockCommand}
    before_sleep_cmd = loginctl lock-session
    inhibit_sleep = 3
}
` + listener(lockMin, "loginctl lock-session")
          + listener(screenOffMin, dpms("disable"), dpms("enable"))
          + listener(suspendMin, "systemctl suspend || loginctl suspend");
    }

    function apply() {
        if (!o.manage) {
            if (started) {
                started = false;
                stopper.command = ["sh", "-c", "pkill -x hypridle; sleep 0.3; hypridle"];
                stopper.running = true;
            }
            return;
        }
        started = true;
        writer.setText(text);
        stopper.command = ["sh", "-c", `pkill -x hypridle; sleep 0.3; exec hypridle -c '${path.replace(/'/g, "'\\''")}'`];
        stopper.running = true;
    }

    // One restart for a burst of changes (typing minutes, the battery state flipping).
    Timer {
        id: debounce
        interval: 800
        onTriggered: root.apply()
    }
    onTextChanged: if (Config.ready && (o.manage || started)) debounce.restart()
    Connections {
        target: root.o
        function onManageChanged() { debounce.restart(); }
    }

    Component.onCompleted: if (Config.ready && o.manage) debounce.restart()
    Connections {
        target: Config
        function onReadyChanged() { if (Config.ready && root.o.manage) debounce.restart(); }
    }

    FileView {
        id: writer
        path: root.path
        atomicWrites: true
        printErrors: false
    }

    // Runs hypridle (or, when switched off, puts the default one back); detached from the shell's lifetime
    // is not needed: it ends with the session.
    Process {
        id: stopper
        stderr: StdioCollector {
            onStreamFinished: if (text.trim() !== "") console.warn("Idle:", text.trim())
        }
    }
}
