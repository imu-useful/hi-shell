pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.common

// Terminal colors from hi-shell's palette, so terminals follow the wallpaper too.
// Writes to ~/.local/state/hi-shell/terminal/:
//   sequences.txt  escape sequences (16 ANSI colors, text, background, cursor) that any
//                  terminal understands; dots/fish/config.fish prints it at startup,
//                  and it's sent to the terminals already open when the palette changes
//   colors.fish    fish's syntax highlighting colors (sourced by the same config)
//   kitty-theme.conf  the same palette plus kitty's tab bar and borders (included by
//                  dots/kitty/kitty.conf; running kittys reload it right away)
//   ~/.config/btop/themes/hi-shell.theme  btop's theme (when ~/.config/btop exists; used by
//                  dots/btop/btop.conf; running btops reload it)
// The ANSI colors are the usual hues, pulled a little towards the primary color so
// they sit with the rest of the palette, lighter in dark mode and deeper in light mode.
Singleton {
    id: root

    readonly property string dir: `${Paths.state}/terminal`

    function hex(c) {
        const h = v => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0");
        return `#${h(c.r)}${h(c.g)}${h(c.b)}`;
    }

    // A hue (0..1) as an ANSI color for this mode, harmonized with the primary.
    function ansi(hue, bright) {
        const dark = Colors.dark;
        const base = Qt.hsla(hue, dark ? 0.62 : 0.70, dark ? (bright ? 0.74 : 0.66) : (bright ? 0.40 : 0.34), 1);
        return Qt.tint(base, Qt.alpha(Colors.m3primary, 0.18));
    }

    // 0..15: black, red, green, yellow, blue, magenta, cyan, white, then bright ones.
    readonly property var palette: {
        const hues = [0, 0.0, 0.33, 0.13, 0.6, 0.83, 0.5, 0];
        const out = [];
        for (const bright of [false, true]) {
            for (let i = 0; i < 8; i++) {
                if (i === 0)
                    out.push(bright ? Colors.m3outline : Colors.m3surfaceContainerHighest);
                else if (i === 7)
                    out.push(bright ? Colors.m3onSurface : Colors.m3onSurfaceVariant);
                else
                    out.push(ansi(hues[i], bright));
            }
        }
        return out;
    }

    readonly property string sequences: {
        const esc = "\x1b]", st = "\x1b\\";
        let s = "";
        palette.forEach((c, i) => s += `${esc}4;${i};${hex(c)}${st}`);
        s += `${esc}10;${hex(Colors.m3onSurface)}${st}`;   // text
        s += `${esc}11;${hex(Colors.m3surface)}${st}`;     // background
        s += `${esc}12;${hex(Colors.m3primary)}${st}`;     // cursor
        s += `${esc}17;${hex(Colors.m3primaryContainer)}${st}`; // selection background
        s += `${esc}19;${hex(Colors.m3onPrimaryContainer)}${st}`; // selection text
        return s;
    }

    readonly property string fish: {
        const c = c => hex(c).slice(1);
        return `# Generated by hi-shell (services/TerminalColors.qml) from the wallpaper's palette.
set -g fish_color_normal ${c(Colors.m3onSurface)}
set -g fish_color_command ${c(Colors.m3primary)}
set -g fish_color_keyword ${c(Colors.m3tertiary)}
set -g fish_color_quote ${c(ansi(0.33, true))}
set -g fish_color_redirection ${c(Colors.m3secondary)}
set -g fish_color_end ${c(Colors.m3secondary)}
set -g fish_color_error ${c(Colors.m3error)}
set -g fish_color_param ${c(Colors.m3onSurface)}
set -g fish_color_option ${c(Colors.m3onSurfaceVariant)}
set -g fish_color_comment ${c(Colors.m3outline)}
set -g fish_color_operator ${c(Colors.m3tertiary)}
set -g fish_color_escape ${c(Colors.m3tertiary)}
set -g fish_color_autosuggestion ${c(Colors.m3outline)}
set -g fish_color_valid_path --underline
set -g fish_color_search_match --background=${c(Colors.m3secondaryContainer)}
set -g fish_color_selection --background=${c(Colors.m3primaryContainer)}
set -g fish_pager_color_prefix ${c(Colors.m3primary)} --bold
set -g fish_pager_color_completion ${c(Colors.m3onSurface)}
set -g fish_pager_color_description ${c(Colors.m3outline)}
set -g fish_pager_color_progress ${c(Colors.m3onPrimaryContainer)} --background=${c(Colors.m3primaryContainer)}
`;
    }

    readonly property string kitty: {
        const h = hex;
        let s = `# Generated by hi-shell (services/TerminalColors.qml) from the wallpaper's palette.
foreground ${h(Colors.m3onSurface)}
background ${h(Colors.m3surface)}
selection_foreground ${h(Colors.m3onPrimaryContainer)}
selection_background ${h(Colors.m3primaryContainer)}
cursor ${h(Colors.m3primary)}
cursor_text_color ${h(Colors.m3onPrimary)}
cursor_trail_color ${h(Colors.m3primary)}
url_color ${h(Colors.m3tertiary)}
active_border_color ${h(Colors.m3primary)}
inactive_border_color ${h(Colors.m3outlineVariant)}
bell_border_color ${h(Colors.m3error)}
tab_bar_background ${h(Colors.m3surface)}
active_tab_foreground ${h(Colors.m3onPrimary)}
active_tab_background ${h(Colors.m3primary)}
inactive_tab_foreground ${h(Colors.m3onSurfaceVariant)}
inactive_tab_background ${h(Colors.m3surfaceContainerHigh)}
mark1_background ${h(Colors.m3tertiaryContainer)}
mark1_foreground ${h(Colors.m3onTertiaryContainer)}
`;
        palette.forEach((c, i) => s += `color${i} ${h(c)}\n`);
        return s;
    }

    // btop's theme: the main background stays empty (the terminal's own), the graphs go
    // from the palette's cool to its warm colors.
    readonly property string btop: {
        const h = hex;
        const t = (name, c) => `theme[${name}]="${h(c)}"\n`;
        const grad = (name, a, b, c) => t(name + "_start", a) + t(name + "_mid", b) + t(name + "_end", c);
        const green = ansi(0.33, true), yellow = ansi(0.13, true), red = ansi(0.0, true), cyan = ansi(0.5, true), blue = ansi(0.6, true);
        return `# Generated by hi-shell (services/TerminalColors.qml) from the wallpaper's palette.
theme[main_bg]=""
` + t("main_fg", Colors.m3onSurface) + t("title", Colors.m3onSurface) + t("hi_fg", Colors.m3primary)
          + t("selected_bg", Colors.m3primaryContainer) + t("selected_fg", Colors.m3onPrimaryContainer)
          + t("inactive_fg", Colors.m3outline) + t("proc_misc", Colors.m3tertiary)
          + t("cpu_box", Colors.m3primary) + t("mem_box", Colors.m3tertiary) + t("net_box", Colors.m3secondary) + t("proc_box", Colors.m3primary)
          + t("div_line", Colors.m3outlineVariant)
          + grad("temp", cyan, yellow, red) + grad("cpu", green, yellow, red)
          + grad("free", red, yellow, green) + grad("cached", blue, cyan, green)
          + grad("available", yellow, green, cyan) + grad("used", green, yellow, red)
          + grad("download", Colors.m3secondary, Colors.m3primary, Colors.m3tertiary)
          + grad("upload", Colors.m3secondary, Colors.m3primary, Colors.m3tertiary);
    }

    function write() {
        writeTimer.stop();
        writer.command = ["sh", "-c", `
            mkdir -p "$1"
            printf %s "$2" > "$1/sequences.txt.tmp" && mv "$1/sequences.txt.tmp" "$1/sequences.txt"
            printf %s "$3" > "$1/colors.fish.tmp" && mv "$1/colors.fish.tmp" "$1/colors.fish"
            printf %s "$4" > "$1/kitty-theme.conf.tmp" && mv "$1/kitty-theme.conf.tmp" "$1/kitty-theme.conf"
            # btop: only for people who use it (its config folder exists). SIGUSR2 reloads it.
            if [ -d "$HOME/.config/btop" ]; then
                mkdir -p "$HOME/.config/btop/themes"
                printf %s "$5" > "$HOME/.config/btop/themes/hi-shell.theme.tmp" && mv "$HOME/.config/btop/themes/hi-shell.theme.tmp" "$HOME/.config/btop/themes/hi-shell.theme"
                pkill -USR2 -x btop 2>/dev/null
            fi
            # kitty reloads its config (and so the theme) on SIGUSR1.
            pkill -USR1 -x kitty 2>/dev/null
            # Recolor the terminals already open, like a fresh start would: only ttys with a
            # shell in them. Other ptys aren't terminals someone looks at; KDE's kwrited, for
            # one, turns whatever is written to its pty into a notification.
            for tty in $(ps -eo tty=,comm= | awk '$1 ~ /^pts\// && $2 ~ /^(fish|zsh|bash|nu|sh|dash|ksh|tcsh|xonsh)$/ {print $1}' | sort -u); do
                t=/dev/$tty
                [ -O "$t" ] && [ -w "$t" ] && printf %s "$2" > "$t" 2>/dev/null
            done
        `, "sh", dir, sequences, fish, kitty, btop];
        writer.running = true;
    }

    // The palette changes a role at a time when the wallpaper changes; write once.
    onSequencesChanged: writeTimer.restart()
    onBtopChanged: writeTimer.restart()
    Timer {
        id: writeTimer
        interval: 800
        onTriggered: root.write()
    }

    Process {
        id: writer
    }

    Component.onCompleted: writeTimer.restart()
}
